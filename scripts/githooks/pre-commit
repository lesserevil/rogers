#!/usr/bin/env bash
# Pre-commit hook.
#
# Install once per clone:
#   git config core.hooksPath scripts/githooks
#
# Runs from the repo root. Hard checks block the commit; soft checks
# warn but allow the commit through. Tune per project — see the
# `PROJECT:` markers below.

set -euo pipefail

fail() { echo "pre-commit: error: $*" >&2; exit 1; }
warn() { echo "pre-commit: warning: $*" >&2; }

# ─── Hard checks (block commit on failure) ────────────────────────

# Formatter drift. Uses the Makefile target so the rule matches what
# `make fmt-check` does in CI.
if [[ -f Makefile ]] && grep -q '^fmt-check:' Makefile; then
    if ! make fmt-check >/dev/null 2>&1; then
        fail "formatter drift — run 'make fmt' and stage the changes"
    fi
fi

# main.rs must change alongside the subcommand registry (cli.rs).
# main.rs contains dispatch logic that pattern-matches on the Commands
# enum defined in cli.rs. Changing main.rs without updating cli.rs
# risks breaking command dispatch or creating orphaned handlers.
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -q '^src/main\.rs$'; then
    if ! echo "$STAGED" | grep -q '^src/cli\.rs$'; then
        fail "src/main.rs is staged but src/cli.rs (command registry) is not — \
both must change together to keep dispatch in sync. \
Use 'git commit --no-verify' to bypass if this is a deliberate exception."
    fi
fi

# ─── Soft checks (warn but allow) ─────────────────────────────────

# Plan-doc sync — warn when staged code under a watched source tree
# changes but no plans/*.md is also staged. Treat the warning as a
# question worth answering, not an obstacle to dismiss; bypass with
# judgment for pure refactors or bug fixes that don't shift design.
#
# PROJECT: this hook hard-blocks on formatter drift (cargo fmt --all --check).
# No other checks run pre-commit by default. Lint/statics are gated
# behind `cargo clippy` in CI, not this hook.
#
# staged=$(git diff --cached --name-only)
# if echo "$staged" | grep -q '^src/' && ! echo "$staged" | grep -q '^plans/.*\.md$'; then
#     warn "code under src/ staged but no plans/*.md updated — confirm this is a non-design change"
# fi

# Plan-ref lint — every open bead carries a `Plan:` line (or an
# exemption label). Opt-in; uncomment once the script is in place.
#
# if [[ -x scripts/bd-plan-ref-lint.sh ]]; then
#     scripts/bd-plan-ref-lint.sh --quiet || \
#         warn "open beads missing 'Plan:' reference — run scripts/bd-plan-ref-lint.sh for details"
# fi

exit 0
